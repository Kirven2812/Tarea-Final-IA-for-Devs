@page "/administracion/libros"
@using Microsoft.AspNetCore.Authorization
@using SistemaBiblioteca.Web.Models
@using SistemaBiblioteca.Web.Services
@attribute [Authorize(Roles = "Administrador")]
@inject LibroService LibroService

<PageTitle>Administración de Libros</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3>Administración de Libros</h3>
        <p class="text-muted">Gestión de libros de la biblioteca.</p>
    </div>

    <button class="btn btn-primary" @onclick="NuevoLibro">
        + Nuevo libro
    </button>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-success">@mensaje</div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <input class="form-control"
               placeholder="Buscar libro por título..."
               @bind="tituloBusqueda"
               @bind:event="oninput"
               @onkeydown="BuscarConEnter" />
    </div>

    <div class="col-auto">
        <button class="btn btn-primary"
                @onclick="BuscarLibros">
            Buscar
        </button>
    </div>

    <div class="col-auto">
        <button class="btn btn-outline-secondary"
                @onclick="LimpiarBusqueda">
            Limpiar
        </button>
    </div>
</div>

@if (cargando)
{
    <div class="text-center p-4">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2">Cargando libros...</p>
    </div>
}
else if (libros.Count == 0)
{
    <div class="alert alert-info">
        No se encontraron libros.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ISBN</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                    <th>Año</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var libro in libros)
                {
                    <tr>
                        <td>@libro.Isbn</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.AutorNombre</td>
                        <td>@libro.CategoriaNombre</td>
                        <td>@libro.AñoPublicacion</td>

                        <td>
                            <span class="badge @(libro.Estado == "Disponible"
                                  ? "bg-success"
                                  : "bg-warning text-dark")">
                                @libro.Estado
                            </span>
                        </td>

                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => EditarLibro(libro)">
                                    Editar
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmarEliminar(libro)">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!cargando)
{
    <div class="d-flex justify-content-between align-items-center mt-4">
        <span>
            Página @pagina de @totalPaginas
            — @totalRegistros registros
        </span>

        <div>
            <button class="btn btn-outline-secondary me-2"
                    disabled="@(pagina <= 1)"
                    @onclick="PaginaAnterior">
                Anterior
            </button>

            <button class="btn btn-outline-secondary"
                    disabled="@(pagina >= totalPaginas)"
                    @onclick="PaginaSiguiente">
                Siguiente
            </button>
        </div>
    </div>
}

@* MODAL PARA REGISTRAR Y EDITAR *@

@if (mostrarFormulario)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true">

        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(editando ? "Editar libro" : "Registrar nuevo libro")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@guardando"
                            @onclick="Cancelar">
                    </button>
                </div>

                <div class="modal-body">

                    @if (editando)
                    {
                        <EditForm Model="modeloEditar"
                                  OnValidSubmit="GuardarEdicion"
                                  FormName="editarLibro">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">ISBN</label>
                                <input class="form-control"
                                       value="@isbnEdicion"
                                       disabled />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Título</label>
                                <InputText class="form-control"
                                           @bind-Value="modeloEditar.Titulo" />
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Categoría</label>

                                <InputSelect class="form-select"
                                             @bind-Value="modeloEditar.CategoriaNombre">

                                    <option value="">Seleccione una categoría</option>

                                    @foreach (var categoria in categorias)
                                    {
                                        <option value="@categoria.NombreCategoria">
                                            @categoria.NombreCategoria
                                        </option>
                                    }

                                </InputSelect>
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Editorial</label>
                                <InputText class="form-control"
                                           @bind-Value="modeloEditar.Editorial" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Lenguaje</label>
                                <InputText class="form-control"
                                           @bind-Value="modeloEditar.Lenguaje" />
                            </div>

                            <div class="modal-footer">
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled="@guardando"
                                        @onclick="Cancelar">
                                    Cancelar
                                </button>

                                <button type="submit"
                                        class="btn btn-success"
                                        disabled="@guardando">
                                    @(guardando ? "Guardando..." : "Guardar cambios")
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="modeloCrear"
                                  OnValidSubmit="GuardarNuevo"
                                  FormName="crearLibro">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">ISBN</label>
                                    <InputText class="form-control"
                                               @bind-Value="modeloCrear.Isbn" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Título</label>
                                    <InputText class="form-control"
                                               @bind-Value="modeloCrear.Titulo" />
                                </div>


                                <div class="col-md-6">
                                    <label class="form-label">Autor</label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="modeloCrear.AutorNombre"
                                                 @bind-Value:after="ActualizarNacionalidad">

                                        <option value="">Seleccione un autor</option>

                                        @foreach (var autor in autores)
                                        {
                                            <option value="@autor.NombreAutor">
                                                @autor.NombreAutor
                                            </option>
                                        }

                                    </InputSelect>
                                </div>


                                <div class="col-md-6">
                                    <label class="form-label">Nacionalidad</label>

                                    <input class="form-control"
                                           value="@modeloCrear.Nacionalidad"
                                           readonly />

                                </div>


                                <div class="col-md-6">
                                    <label class="form-label">Categoría</label>

                                    <InputSelect class="form-select"
                                                 @bind-Value="modeloCrear.CategoriaNombre">

                                        <option value="">Seleccione una categoría</option>

                                        @foreach (var categoria in categorias)
                                        {
                                            <option value="@categoria.NombreCategoria">
                                                @categoria.NombreCategoria
                                            </option>
                                        }

                                    </InputSelect>
                                </div>


                                <div class="col-md-6">
                                    <label class="form-label">Año de publicación</label>
                                    <InputNumber class="form-control"
                                                 @bind-Value="modeloCrear.AñoPublicacion" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Editorial</label>
                                    <InputText class="form-control"
                                               @bind-Value="modeloCrear.Editorial" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Lenguaje</label>
                                    <InputText class="form-control"
                                               @bind-Value="modeloCrear.Lenguaje" />
                                </div>

                            </div>

                            <div class="modal-footer mt-3">
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled="@guardando"
                                        @onclick="Cancelar">
                                    Cancelar
                                </button>

                                <button type="submit"
                                        class="btn btn-success"
                                        disabled="@guardando">
                                    @(guardando ? "Guardando..." : "Guardar libro")
                                </button>
                            </div>
                        </EditForm>
                    }

                </div>
            </div>
        </div>
    </div>
}

@* MODAL PARA ELIMINAR *@

@if (libroEliminar is not null)
{
    <div class="modal-backdrop fade show"></div>

    <div class="modal fade show d-block"
         tabindex="-1"
         role="alertdialog"
         aria-modal="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        Confirmar eliminación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            disabled="@guardando"
                            @onclick="Cancelar">
                    </button>
                </div>

                <div class="modal-body">
                    <p>
                        ¿Deseas eliminar el libro
                        <strong>@libroEliminar.Titulo</strong>?
                    </p>

                    <p class="text-muted mb-0">
                        Esta acción no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            disabled="@guardando"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button class="btn btn-danger"
                            disabled="@guardando"
                            @onclick="EliminarLibro">
                        @(guardando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private List<LibroModel> libros = new();
    private CrearLibroModel modeloCrear = new();
    private ActualizarLibroModel modeloEditar = new();

    private List<AutorModel> autores = new();
    private List<CategoriaModel> categorias = new();


    private LibroModel? libroEliminar;
    private string isbnEdicion = "";
    private string tituloBusqueda = "";

    private string? mensaje;
    private string? error;

    private bool cargando = true;
    private bool guardando;
    private bool mostrarFormulario;
    private bool editando;

    private int pagina = 1;
    private int totalPaginas = 1;
    private int totalRegistros;


    protected override async Task OnInitializedAsync()
    {
        await CargarLibros();

        try
        {
            autores = await LibroService.ObtenerAutoresAsync();
            categorias = await LibroService.ObtenerCategoriasAsync();
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los autores y categorías.";
        }
    }

    private async Task CargarLibros()
    {
        try
        {
            cargando = true;
            error = null;

            var resultado = await LibroService.BuscarAsync(
                titulo: tituloBusqueda,
                pagina: pagina,
                tamañoPagina: 10);

            libros = resultado?.Items ?? new();
            totalPaginas = Math.Max(1, resultado?.TotalPaginas ?? 1);
            totalRegistros = resultado?.TotalRegistros ?? 0;
        }
        catch (Exception)
        {
            error = "No se pudieron cargar los libros.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarLibros()
    {
        pagina = 1;
        await CargarLibros();
    }

    private async Task BuscarConEnter(
        Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarLibros();
        }
    }

    private async Task LimpiarBusqueda()
    {
        tituloBusqueda = "";
        pagina = 1;
        await CargarLibros();
    }

    private async Task PaginaAnterior()
    {
        if (pagina > 1)
        {
            pagina--;
            await CargarLibros();
        }
    }

    private async Task PaginaSiguiente()
    {
        if (pagina < totalPaginas)
        {
            pagina++;
            await CargarLibros();
        }
    }

    private void NuevoLibro()
    {
        modeloCrear = new CrearLibroModel();
        mostrarFormulario = true;
        editando = false;
        libroEliminar = null;
        mensaje = null;
        error = null;
    }

    private void EditarLibro(LibroModel libro)
    {
        isbnEdicion = libro.Isbn;

        modeloEditar = new ActualizarLibroModel
        {
            Titulo = libro.Titulo,
            CategoriaNombre = libro.CategoriaNombre,
            Editorial = libro.Editorial,
            Lenguaje = libro.Lenguaje
        };

        editando = true;
        mostrarFormulario = true;
        libroEliminar = null;
        mensaje = null;
        error = null;
    }

    private async Task GuardarNuevo()
    {
        try
        {
            guardando = true;
            error = null;

            await LibroService.CrearAsync(modeloCrear);

            Cancelar();
            mensaje = "Libro registrado correctamente.";

            pagina = 1;
            tituloBusqueda = "";

            await CargarLibros();
        }
        catch (Exception ex)
        {
            error = $"No se pudo registrar el libro: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarEdicion()
    {
        try
        {
            guardando = true;
            error = null;

            await LibroService.ActualizarAsync(
                isbnEdicion, modeloEditar);

            Cancelar();
            mensaje = "Libro actualizado correctamente.";

            await CargarLibros();
        }
        catch (Exception ex)
        {
            error = $"No se pudo actualizar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void ConfirmarEliminar(LibroModel libro)
    {
        libroEliminar = libro;
        mostrarFormulario = false;
        mensaje = null;
        error = null;
    }

    private async Task EliminarLibro()
    {
        if (libroEliminar is null)
            return;

        try
        {
            guardando = true;
            error = null;

            await LibroService.EliminarAsync(libroEliminar.Isbn);

            Cancelar();
            mensaje = "Libro eliminado correctamente.";

            await CargarLibros();

            if (libros.Count == 0 && pagina > 1)
            {
                pagina--;
                await CargarLibros();
            }
        }
        catch (Exception ex)
        {
            error = $"No se pudo eliminar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        editando = false;
        libroEliminar = null;
    }


    private void ActualizarNacionalidad()
    {
        var autor = autores.FirstOrDefault(a =>
            a.NombreAutor == modeloCrear.AutorNombre);

        modeloCrear.Nacionalidad =
            autor?.Nacionalidad ?? string.Empty;
    }

}
