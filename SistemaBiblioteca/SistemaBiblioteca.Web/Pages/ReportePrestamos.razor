@page "/administracion/prestamos"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container mt-4">
    <h2 class="mb-4">Reporte de Préstamos</h2>

    <!-- TARJETA DE FILTROS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="bi bi-funnel"></i> Filtros de Búsqueda
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" @bind="fechaInicio" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" @bind="fechaFin" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Autor</label>
                    <input type="text" @bind="autor" placeholder="Ej. Gabriel García..." class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nombre del Libro</label>
                    <input type="text" @bind="nombreLibro" placeholder="Ej. Cien años..." class="form-control" />
                </div>

                <div class="col-12 d-flex justify-content-between mt-3">
                    <div>
                        <button class="btn btn-primary" @onclick="CargarReporte">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros">
                            Limpiar Filtros
                        </button>
                    </div>

                    <!-- BOTONES DE EXPORTACIÓN CON FILTROS ACTUALES -->
                    <div>
                        <button class="btn btn-success" @onclick="ExportarExcel">
                            Exportar a Excel
                        </button>
                        <button class="btn btn-danger" @onclick="ExportarPdf">
                            Exportar a PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE RESULTADOS REACTIVA -->
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Libro</th>
                    <th>Autor</th>
                    <th>Fecha Préstamo</th>
                    <th>Fecha Devolución</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (prestamos == null)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 mb-0">Cargando datos del reporte...</p>
                        </td>
                    </tr>
                }
                else if (!prestamos.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No se encontraron préstamos con los filtros seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in prestamos)
                    {
                        <tr>
                            <td>@item.IdPrestamo</td>
                            <td>@item.Usuario</td>
                            <td>@item.Libro</td>
                            <td>@item.Autor</td>
                            <td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td>@(item.FechaDevolucion.HasValue ? item.FechaDevolucion.Value.ToString("dd/MM/yyyy") : "Pendiente")</td>
                            <td>
                                @if (item.Estado == "Devuelto")
                                {
                                    <span class="badge bg-success">Devuelto</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ReportePrestamoViewModel>? prestamos;
    private DateTime? fechaInicio;
    private DateTime? fechaFin;
    private string? autor;
    private string? nombreLibro;

    protected override async Task OnInitializedAsync()
    {
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        var queryParams = new List<string>();
        if (fechaInicio.HasValue) queryParams.Add($"fechaInicio={fechaInicio.Value:yyyy-MM-dd}");
        if (fechaFin.HasValue) queryParams.Add($"fechaFin={fechaFin.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(autor)) queryParams.Add($"autor={Uri.EscapeDataString(autor)}");
        if (!string.IsNullOrWhiteSpace(nombreLibro)) queryParams.Add($"nombreLibro={Uri.EscapeDataString(nombreLibro)}");

        var url = "api/Prestamos/reporte";
        if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

        try
        {
            prestamos = await Http.GetFromJsonAsync<List<ReportePrestamoViewModel>>(url);
        }
        catch (Exception)
        {
            prestamos = new List<ReportePrestamoViewModel>();
        }
    }

    private async Task LimpiarFiltros()
    {
        fechaInicio = null;
        fechaFin = null;
        autor = null;
        nombreLibro = null;
        await CargarReporte();
    }

    private void ExportarExcel()
    {
        var query = ConstruirQueryString();
        Navigation.NavigateTo($"/Prestamos/ExportarExcel{query}", true);
    }

    private void ExportarPdf()
    {
        var query = ConstruirQueryString();
        Navigation.NavigateTo($"/Prestamos/ExportarPdf{query}", true);
    }

    private string ConstruirQueryString()
    {
        var queryParams = new List<string>();
        if (fechaInicio.HasValue) queryParams.Add($"fechaInicio={fechaInicio.Value:yyyy-MM-dd}");
        if (fechaFin.HasValue) queryParams.Add($"fechaFin={fechaFin.Value:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(autor)) queryParams.Add($"autor={Uri.EscapeDataString(autor)}");
        if (!string.IsNullOrWhiteSpace(nombreLibro)) queryParams.Add($"nombreLibro={Uri.EscapeDataString(nombreLibro)}");
        return queryParams.Any() ? "?" + string.Join("&", queryParams) : "";
    }

    public class ReportePrestamoViewModel
    {
        public int IdPrestamo { get; set; }
        public string Usuario { get; set; } = string.Empty;
        public string Libro { get; set; } = string.Empty;
        public string Autor { get; set; } = string.Empty;
        public DateTime FechaPrestamo { get; set; }
        public DateTime? FechaDevolucion { get; set; }
        public string Estado { get; set; } = string.Empty;
    }
}